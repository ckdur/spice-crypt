# Source for the compiled Rust extension (see setup.py)
include Cargo.toml Cargo.lock
include spice_crypt/pspice/_aes_brute.rs

include REUSE.toml
recursive-include LICENSES *.txt
recursive-include SPECIFICATIONS *.md
recursive-include tests *.py *.lib *.mdl

global-exclude *.so *.pyd *.dll __pycache__ *.py[cod]
